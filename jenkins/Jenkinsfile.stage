// Orchestrator Pipeline for STAGE Environment
// Includes integration tests and E2E tests after deployment

pipeline {
    agent any

    tools {
        maven 'Maven'
    }

    environment {
        DOCKER_NAMESPACE = 'ecommerce-microservices'
        PROJECT_VERSION = '0.1.0'
        KUBE_NAMESPACE = 'ecommerce-stage'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
        timeout(time: 90, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_COMMIT_SHORT = sh(script: "git rev-parse --short HEAD", returnStdout: true).trim()
                    env.GIT_COMMIT_MSG = sh(script: "git log -1 --pretty=%B", returnStdout: true).trim()
                    env.GIT_AUTHOR = sh(script: "git log -1 --pretty=%an", returnStdout: true).trim()
                    env.BUILD_TIMESTAMP = sh(script: "date +%Y%m%d-%H%M%S", returnStdout: true).trim()
                }
                echo "=========================================="
                echo "STAGE Environment Build"
                echo "Commit: ${env.GIT_COMMIT_SHORT}"
                echo "Author: ${env.GIT_AUTHOR}"
                echo "Message: ${env.GIT_COMMIT_MSG}"
                echo "=========================================="
            }
        }

        // Stage 1: Build Infrastructure Services
        stage('Build Infrastructure Services') {
            parallel {
                stage('service-discovery') {
                    steps {
                        dir('service-discovery') {
                            sh 'mvn clean compile package -DskipTests'
                            sh """
                                docker build \
                                    --build-arg PROJECT_VERSION=${PROJECT_VERSION} \
                                    -t ${DOCKER_NAMESPACE}/service-discovery:${env.GIT_COMMIT_SHORT} \
                                    -t ${DOCKER_NAMESPACE}/service-discovery:stage-latest \
                                    .
                            """
                        }
                    }
                }
                stage('cloud-config') {
                    steps {
                        dir('cloud-config') {
                            sh 'mvn clean compile package -DskipTests'
                            sh """
                                docker build \
                                    --build-arg PROJECT_VERSION=${PROJECT_VERSION} \
                                    -t ${DOCKER_NAMESPACE}/cloud-config:${env.GIT_COMMIT_SHORT} \
                                    -t ${DOCKER_NAMESPACE}/cloud-config:stage-latest \
                                    .
                            """
                        }
                    }
                }
            }
        }

        // Stage 2: Build Gateway Services
        stage('Build Gateway Services') {
            parallel {
                stage('api-gateway') {
                    steps {
                        dir('api-gateway') {
                            sh 'mvn clean compile package -DskipTests'
                            sh """
                                docker build \
                                    --build-arg PROJECT_VERSION=${PROJECT_VERSION} \
                                    -t ${DOCKER_NAMESPACE}/api-gateway:${env.GIT_COMMIT_SHORT} \
                                    -t ${DOCKER_NAMESPACE}/api-gateway:stage-latest \
                                    .
                            """
                        }
                    }
                }
                stage('proxy-client') {
                    steps {
                        dir('proxy-client') {
                            sh 'mvn clean compile package -DskipTests'
                            sh """
                                docker build \
                                    --build-arg PROJECT_VERSION=${PROJECT_VERSION} \
                                    -t ${DOCKER_NAMESPACE}/proxy-client:${env.GIT_COMMIT_SHORT} \
                                    -t ${DOCKER_NAMESPACE}/proxy-client:stage-latest \
                                    .
                            """
                        }
                    }
                }
            }
        }

        // Stage 3: Build & Test Business Services
        stage('Build & Test Business Services') {
            parallel {
                stage('user-service') {
                    steps {
                        dir('user-service') {
                            sh 'mvn clean test'
                            sh 'mvn package -DskipTests'
                            sh """
                                docker build \
                                    --build-arg PROJECT_VERSION=${PROJECT_VERSION} \
                                    -t ${DOCKER_NAMESPACE}/user-service:${env.GIT_COMMIT_SHORT} \
                                    -t ${DOCKER_NAMESPACE}/user-service:stage-latest \
                                    .
                            """
                        }
                    }
                    post {
                        always {
                            junit allowEmptyResults: true, testResults: 'user-service/target/surefire-reports/*.xml'
                        }
                    }
                }
                stage('product-service') {
                    steps {
                        dir('product-service') {
                            sh 'mvn clean test'
                            sh 'mvn package -DskipTests'
                            sh """
                                docker build \
                                    --build-arg PROJECT_VERSION=${PROJECT_VERSION} \
                                    -t ${DOCKER_NAMESPACE}/product-service:${env.GIT_COMMIT_SHORT} \
                                    -t ${DOCKER_NAMESPACE}/product-service:stage-latest \
                                    .
                            """
                        }
                    }
                    post {
                        always {
                            junit allowEmptyResults: true, testResults: 'product-service/target/surefire-reports/*.xml'
                        }
                    }
                }
                stage('order-service') {
                    steps {
                        dir('order-service') {
                            sh 'mvn clean test'
                            sh 'mvn package -DskipTests'
                            sh """
                                docker build \
                                    --build-arg PROJECT_VERSION=${PROJECT_VERSION} \
                                    -t ${DOCKER_NAMESPACE}/order-service:${env.GIT_COMMIT_SHORT} \
                                    -t ${DOCKER_NAMESPACE}/order-service:stage-latest \
                                    .
                            """
                        }
                    }
                    post {
                        always {
                            junit allowEmptyResults: true, testResults: 'order-service/target/surefire-reports/*.xml'
                        }
                    }
                }
                stage('payment-service') {
                    steps {
                        dir('payment-service') {
                            sh 'mvn clean test'
                            sh 'mvn package -DskipTests'
                            sh """
                                docker build \
                                    --build-arg PROJECT_VERSION=${PROJECT_VERSION} \
                                    -t ${DOCKER_NAMESPACE}/payment-service:${env.GIT_COMMIT_SHORT} \
                                    -t ${DOCKER_NAMESPACE}/payment-service:stage-latest \
                                    .
                            """
                        }
                    }
                    post {
                        always {
                            junit allowEmptyResults: true, testResults: 'payment-service/target/surefire-reports/*.xml'
                        }
                    }
                }
                stage('shipping-service') {
                    steps {
                        dir('shipping-service') {
                            sh 'mvn clean test'
                            sh 'mvn package -DskipTests'
                            sh """
                                docker build \
                                    --build-arg PROJECT_VERSION=${PROJECT_VERSION} \
                                    -t ${DOCKER_NAMESPACE}/shipping-service:${env.GIT_COMMIT_SHORT} \
                                    -t ${DOCKER_NAMESPACE}/shipping-service:stage-latest \
                                    .
                            """
                        }
                    }
                    post {
                        always {
                            junit allowEmptyResults: true, testResults: 'shipping-service/target/surefire-reports/*.xml'
                        }
                    }
                }
                stage('favourite-service') {
                    steps {
                        dir('favourite-service') {
                            sh 'mvn clean test'
                            sh 'mvn package -DskipTests'
                            sh """
                                docker build \
                                    --build-arg PROJECT_VERSION=${PROJECT_VERSION} \
                                    -t ${DOCKER_NAMESPACE}/favourite-service:${env.GIT_COMMIT_SHORT} \
                                    -t ${DOCKER_NAMESPACE}/favourite-service:stage-latest \
                                    .
                            """
                        }
                    }
                    post {
                        always {
                            junit allowEmptyResults: true, testResults: 'favourite-service/target/surefire-reports/*.xml'
                        }
                    }
                }
            }
        }

        // Stage 4: Coverage Reports
        stage('Coverage Reports') {
            steps {
                sh 'mvn jacoco:report -pl user-service,product-service,order-service,payment-service,shipping-service,favourite-service'
            }
            post {
                always {
                    jacoco(
                        execPattern: '**/target/jacoco.exec',
                        classPattern: '**/target/classes',
                        sourcePattern: '**/src/main/java',
                        exclusionPattern: '**/test/**'
                    )
                }
            }
        }

        // Stage 5: Push Docker Images
        stage('Push Docker Images') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'docker-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'

                        def services = [
                            'service-discovery',
                            'cloud-config',
                            'api-gateway',
                            'proxy-client',
                            'user-service',
                            'product-service',
                            'order-service',
                            'payment-service',
                            'shipping-service',
                            'favourite-service'
                        ]

                        services.each { service ->
                            sh """
                                docker push ${DOCKER_NAMESPACE}/${service}:${env.GIT_COMMIT_SHORT}
                                docker push ${DOCKER_NAMESPACE}/${service}:stage-latest
                            """
                        }
                    }
                }
            }
        }

        // Stage 6: Deploy to Kubernetes STAGE
        stage('Deploy to Kubernetes STAGE') {
            steps {
                script {
                    withKubeConfig([credentialsId: 'kubeconfig-credentials']) {
                        sh """
                            echo "Deploying to ${KUBE_NAMESPACE}..."
                            kubectl apply -k k8s/overlays/stage/

                            echo "Waiting for deployments to be ready..."
                            kubectl rollout status deployment -n ${KUBE_NAMESPACE} --timeout=300s || true

                            echo "Current pod status:"
                            kubectl get pods -n ${KUBE_NAMESPACE}
                        """
                    }
                }
            }
        }

        // Stage 7: Health Check
        stage('Health Check') {
            steps {
                script {
                    withKubeConfig([credentialsId: 'kubeconfig-credentials']) {
                        sh """
                            echo "Checking service health..."

                            # Wait for pods to be ready
                            sleep 30

                            # Check pod status
                            kubectl get pods -n ${KUBE_NAMESPACE} -o wide

                            # Check services
                            kubectl get svc -n ${KUBE_NAMESPACE}
                        """
                    }
                }
            }
        }

        // Stage 8: Integration Tests
        stage('Integration Tests') {
            steps {
                dir('tests/integration') {
                    sh 'mvn test -Dtest=*IT'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'tests/integration/target/surefire-reports/*.xml'
                }
            }
        }

        // Stage 9: E2E Tests
        stage('E2E Tests') {
            steps {
                dir('tests/e2e') {
                    sh 'mvn test -Dtest=*E2ETest'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'tests/e2e/target/surefire-reports/*.xml'
                }
            }
        }
    }

    post {
        always {
            // Archive test results
            junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'

            // Archive JARs
            archiveArtifacts artifacts: '**/target/*.jar', fingerprint: true, allowEmptyArchive: true
        }
        success {
            echo "=========================================="
            echo "STAGE Build SUCCESS"
            echo "Commit: ${env.GIT_COMMIT_SHORT}"
            echo "All services built, deployed and tested in ${KUBE_NAMESPACE}"
            echo "=========================================="
        }
        failure {
            echo "=========================================="
            echo "STAGE Build FAILED"
            echo "Commit: ${env.GIT_COMMIT_SHORT}"
            echo "Check logs for details"
            echo "=========================================="
        }
        cleanup {
            cleanWs()
        }
    }
}
